! Genere par Ansible - ne pas modifier a la main
frr version 8.4
frr defaults datacenter
hostname {{ inventory_hostname }}
ip forwarding
!
interface lo
 ip address {{ loopback_ip }}/32
!
{% for i in underlay_interfaces %}
interface {{ i.name }}
 ip address {{ i.ip }}
!
{% endfor %}
router bgp {{ bgp_asn }}
 bgp router-id {{ loopback_ip }}
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 bgp bestpath as-path multipath-relax
{% for n in underlay_neighbors %}
 neighbor {{ n.address }} remote-as {{ n.remote_as }}
{% endfor %}
{% for n in evpn_neighbors %}
 neighbor {{ n.address }} remote-as {{ n.remote_as }}
 neighbor {{ n.address }} update-source lo
 neighbor {{ n.address }} ebgp-multihop 5
 neighbor {{ n.address }} send-community extended
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ loopback_ip }}/32
{% for n in underlay_neighbors %}
  neighbor {{ n.address }} activate
{% endfor %}
  maximum-paths 2
 exit-address-family
 !
 address-family l2vpn evpn
{% for n in evpn_neighbors %}
  neighbor {{ n.address }} activate
{% endfor %}
{% if l2_vnis | default([]) | length > 0 %}
  advertise-all-vni
{% endif %}
{% for v in l2_vnis | default([]) %}
  vni {{ v.vni }}
   route-target import 65000:{{ v.vni }}
   route-target export 65000:{{ v.vni }}
  exit-vni
{% endfor %}
 exit-address-family
!
line vty
!
